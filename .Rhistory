chemin_fichier <- file.path(getwd(), "Bases", "data_job_satisfaction.csv")
brut_data <- read.csv(chemin_fichier, sep=',')
#We stock the variables in a vector
liste_var<-c("y15_Q2c","y15_Q2a", "y15_Q2b", "y15_Q2d", "y15_Q14_lt", "y15_Q24", "y15_Q25" , "y15_Q24 - Y15_Q25", "y15_Q36", "y15_Q53d", "y15_Q53e", "y15_Q53f", "y15_Q88", "y15_Q89b", "y15_Q104_euro", "y15_ISCED_lt","y15_Q61j", "y15_Q89a", "y15_Q101f", "y15_Q18b", "y15_Q89d", "y15_Q61a", "y15_Q70e", "y15_Q63d", "y15_Q61b", "y15_Q63e")
#We stock the names for each variables
names_var<-c("Job_Statute", "Sex", "Age", "Full_Time", "Private",  "Work_Hours", "Hours_Wanted" , "Mismatch_hours", "Travel_time", "Monotonous","Complex_Tasks", "Learning", "Job_Satisfaction", "Career", "Salary", "Education","Useful_Work" ,"Appropriately_Paid", "Payment_Individual", "Promo", "Relation", "Support_Colleagues","Cooperation_Colleagues", "Competent_Sup", "Support_Manager","Sup_Useful_Comp")
base_partial <- brut_data[, match(liste_var, names(brut_data), nomatch = 0)]
# We create a database with only our interest variables in the desired order
code_to_name <- data.frame(code_var = c("y15_Q2c","y15_Q2a", "y15_Q2b", "y15_Q2d", "y15_Q14_lt", "y15_Q24", "y15_Q25" , "y15_Q36", "y15_Q53d", "y15_Q53e", "y15_Q53f", "y15_Q88", "y15_Q89b", "y15_Q104_euro", "y15_ISCED_lt","y15_Q61j", "y15_Q89a", "y15_Q101f", "y15_Q18b", "y15_Q89d", "y15_Q61a", "y15_Q70e", "y15_Q63d", "y15_Q61b", "y15_Q63e"),name_var = c("Job_Statute", "Sex", "Age", "Full_Time", "Private",  "Work_Hours", "Hours_Wanted" , "Travel_time", "Monotonous","Complex_Tasks", "Learning", "Job_Satisfaction", "Career", "Salary", "Education","Useful_Work" ,"Appropriately_Paid", "Payment_Individual", "Promo", "Relation", "Support_Colleagues","Cooperation_Colleagues", "Competent_Sup", "Support_Manager","Sup_Useful_Comp"))
#Loop to rename
names(base_partial) <- sapply(names(base_partial), function(col) {
if (col %in% code_to_name$code_var) {
return(code_to_name$name_var[code_to_name$code_var == col])
} else {
return(col)
}
})
#We keep only the people that are working
base_partial <- base_partial[base_partial$`Job_Statute` %in% c(1,4), ]
#We create the variable Mismatch_hours
base_partial$Mismatch_hours <- base_partial$Work_Hours - base_partial$Hours_Wanted
## We create three datasets according to the type of responses to the Salary
# Dataset of people who respond to the question of Salary
bdd_A_salary = base_partial[base_partial$Salary != 88888888 & base_partial$Salary != 99999999  , ]
# Dataset of people who declare that they don't know their salary
bdd_DK_salary = base_partial[base_partial$Salary == 88888888,]
# Dataset of people who refuse to awnser the question of salary
bdd_RR_salary = base_partial[base_partial$Salary == 99999999,]
#We create a list of non-response values
values_no_responses <- list(
"Age" = c(888,999),
"Sex" = c(8, 9),
"Full_Time" = c(8, 9),
"Private" = c(9),
"Work_Hours" = c(888, 999),
"Hours_wanted" = c(888, 999),
"Travel_time" = c(777, 888, 999),
"Monotonous" = c(8, 9),
"Complex_Tasks" = c(8, 9),
"Learning" = c(8, 9),
"Job_Satisfaction" = c(8, 9),
"Career" = c(7, 8, 9),
"Salary" = c(88888888, 99999999),
"Useful_Work" = c(7,8,9),
"Appropriately_Paid" = c(7,8, 9),
"Payment_Individual" = c(8,9),
"Promo" = c(8,9),
"Relation" = c(7,8,9),
"Support_Colleagues" = c(7,8, 9),
"Cooperation_Colleagues" = c(7,8, 9),
"Competent_Sup"=c(7,8, 9),
"Support_Manager"=c(7,8, 9),
"Sup_Useful_Comp"=c(7,8, 9)
)
# We create a loop to replace these values with a NAs
for (col in names(values_no_responses)) {
if (col %in% colnames(base_partial)) {
base_partial[[col]][base_partial[[col]] %in% values_no_responses[[col]]] <- NA
}
}
install.packages("dplyr")
library(dplyr)
## Sex
#1 meant man and 2 women , we want 0 to be man and 1 woman
base_partial <- base_partial %>% mutate(Sex =  Sex - 1)
## Monotonous
#We want 2 to become 0 and 1 to remain  1
base_partial <- base_partial %>% mutate(Monotonous = 2 - Monotonous)
## Learning
#We want 2 to become 0 and 1 to remain  1
base_partial <- base_partial %>% mutate(Learning = 2 -Learning)
## Complex Tasks
#We want 2 to become 0 and 1 to remain  1
base_partial <- base_partial %>% mutate(Complex_Tasks = 2- Complex_Tasks)
##Carrer
# As we encoutered with the job satisfaction, we want ton invert the encoding
base_partial <- base_partial%>% mutate(Career = 6 - Career)
##Salary
# We chose to work with a log-salary instead of a salary
base_partial$Salary_log <- log(base_partial$Salary + 1)
##Full_Time
#Same thing as we did with Learning
base_partial$Full_Time <- base_partial$Full_Time - 1
##Private
base_partial$Private <- ifelse(base_partial$Private == 2, 0, base_partial$Private)
##Job Satisfaction
base_partial <-base_partial %>% mutate(Job_Satisfaction = 5- Job_Satisfaction)
#Useful_Work
base_partial <-base_partial %>% mutate(Useful_Work = 6- Useful_Work)
#Appropriatley_Paid
base_partial <-base_partial %>% mutate(Appropriately_Paid = 6- Appropriately_Paid)
#Payment_Individual
base_partial <-base_partial %>% mutate(Payment_Individual = 2- Payment_Individual)
#Promo
base_partial <-base_partial %>% mutate(Promo = 6- Promo)
#Relation
base_partial <-base_partial %>% mutate(Relation = 6- Relation)
#Support_Colleagues
base_partial <-base_partial %>% mutate(Support_Colleagues = 6- Support_Colleagues)
#Cooperation_Colleagues
base_partial <-base_partial %>% mutate(Cooperation_Colleagues = 6- Cooperation_Colleagues)
#Competent_Sup
base_partial <-base_partial %>% mutate(Competent_Sup = 6- Competent_Sup)
#Support_Manager
base_partial <-base_partial %>% mutate(Support_Manager = 6- Support_Manager)
#Sup_Useful_Comp
base_partial <-base_partial %>% mutate(Sup_Useful_Comp = 6- Sup_Useful_Comp)
#Mismatch hours
base_partial <- base_partial %>% mutate(Mismatch_hours = ifelse(Mismatch_hours == 0, 0, 1))
#First we compute the means
mean(bdd_A_salary$Job_Satisfaction)
mean(bdd_DK_salary$Job_Satisfaction)
mean(bdd_RR_salary$Job_Satisfaction)
#Then we check if there's no big difference in term of means for each category
t.test(bdd_A_salary$Job_Satisfaction,bdd_DK_salary$Job_Satisfaction)
t.test(bdd_A_salary$Job_Satisfaction,bdd_RR_salary$Job_Satisfaction)
t.test(bdd_RR_salary$Job_Satisfaction,bdd_DK_salary$Job_Satisfaction)
base_partial <- base_partial[, !names(base_partial) %in% "Salary"]
write.csv(base_partial, file = "Bases/base_partial.csv", row.names = FALSE)
