#We display the table showing the coefficients , the R^2 and all necessary information in a table called resultats_regressioin_logit
stargazer(model, type = "html", out = "Tableaux/resultats_regression_logit.html",title = "Estimators for the logit ",add.lines = list(c(" McFadden R² ", round(mcfadden_r2["McFadden"], 4))))
model_cross = clm(Job_Satisfaction ~ Age + Full_Time + Private + Monotonous + Complex_Tasks + Learning + Career+ Work_Hours + Mismatch_hours + Salary_log + Age * Full_Time + Age * Complex_Tasks + Private*Work_Hours + Complex_Tasks*Learning , data= base_complete)
summary(model_cross)
#McFadden R^2
mcfadden_r2_cross <- pR2(model_cross)
#We display the table showing the coefficients , the R^2 and all necessary information in a table called resultats_regressioin_logit_cross
stargazer(model_cross, type = "html", out = "Tableaux/resultats_regression_logit_cross.html",title = "Estimators for the logit with cross effects",add.lines = list(c("R² de McFadden", round(mcfadden_r2_cross["McFadden"], 4))))
