#We load the needed library
install.packages("MatchIt")
library(MatchIt)
base_complete$Job_Satisfaction_Binary <- base_complete$Job_Satisfaction
base_complete$Job_Satisfaction_Binary <- ifelse(base_complete$Job_Satisfaction_Binary %in% c(3, 4), 1, 0)
#First we calculate the propensity score
prop_score_dh <- matchit(Mismatch_hours ~ Sex + Age + Full_Time + Private + Work_Hours + Career + Monotonous + Complex_Tasks + Learning + Salary_log, data = base_complete, method = "nearest", distance = "logit")
#Then we extract the propensity score for each variables ( distance, weight, subclass)
prop_score_dh_i <- match.data(prop_score_dh)
#Then we make sure that it has the right format
prop_score_dh_i$Job_Satisfaction_Binary <- as.integer(as.character(prop_score_dh_i$Job_Satisfaction_Binary))
#Finally we regress Job_Satisfaction on Diff_Hours from the prop_score dataset
lm_dh <- lm(Job_Satisfaction_Binary ~ Mismatch_hours, data = prop_score_dh_i)
summary(lm_dh)
#We display the table showing the coefficients , the R^2 and all necessary information in a table called resultats_matching_Mismatch_Hours
stargazer(lm_dh,
type = "html",
out = "Tableaux/resultats_matching_Mismatch_Hours.html",
title = "Matching for Mismatch hours",
label = "tab:matching_results",
ci = TRUE,
single.row = TRUE,
no.space = TRUE)
#Same method as with the variavle Mismatch_Hours
prop_score_pt <- matchit(Full_Time ~ Sex + Age + Mismatch_hours + Private + Work_Hours + Career + Monotonous + Complex_Tasks + Learning + Salary_log,data = base_complete, method = "nearest", distance = "logit")
prop_score_pt_i <- match.data(prop_score_pt)
prop_score_pt_i$Job_Satisfaction_Binary <- as.integer(as.character(prop_score_pt_i$Job_Satisfaction_Binary))
lm_pt <- lm(Job_Satisfaction_Binary ~ Full_Time, data = prop_score_pt_i)
summary(lm_pt)
#We display the table showing the coefficients , the R^2 and all necessary information in a table called resultats_matching_Part_Time
stargazer(lm_pt,
type = "html",
out = "Tableaux/resultats_matching_Part_Time.html",
title = "Matching for Part Time / Full Time",
label = "tab:matching_results",
ci = TRUE,
single.row = TRUE,
no.space = TRUE)
#Then let us identify each variable to each dimension and compute the sum
Pay <-base_complete$Appropriately_Paid + base_complete$Payment_Individual
Job_Opportunities <- as.numeric(base_complete$Career) + base_complete$Promo
Supervision <- base_complete$Support_Manager + base_complete$Competent_Sup + base_complete$Sup_Useful_Comp
Coworkers <- base_complete$Support_Colleagues + base_complete$Relation + base_complete$Cooperation_Colleagues
Work <- as.numeric(base_complete$Monotonous) + base_complete$Useful_Work
#We create new variables
base_complete$Pay <- Pay
label(base_complete$Pay) <- "First dimension of the JDI"
base_complete$Job_Opportunities <- Job_Opportunities
label(base_complete$Job_Opportunities) <- "Second dimension of the JDI"
base_complete$Supervision <- Supervision
label(base_complete$Supervision) <- "Third dimension of the JDI"
base_complete$Coworkers <- Coworkers
label(base_complete$Coworkers) <- "Fourth dimension of the JDI"
base_complete$Work <- Work
label(base_complete$Work) <- "Fifth dimension of the JDI"
#We do an OLS without intercept
model_JDI<-lm(as.numeric(Job_Satisfaction)~  Pay+Job_Opportunities + Supervision + Coworkers + Work , data=base_complete)
summary(model_JDI)
#We want to stock the " weights" in a vector
weights_JDI<-model_JDI$coefficients
weights_JDI
#We display the table showing the coefficients , the R^2 and all necessary information in a table called resultats_regressioin_JDI
stargazer(model_JDI, type = "html", out = "Tableaux/resultats_regression_JDI.html",title = "Estimation for the 'weights' composing JDI")
library(car)
print(vif(model_JDI))
### autocorrélation of the residuals
install.packages("lmtest")
library(lmtest)
dwtest(model_JDI)
### Homoskedasticity
install.packages("lmtest")
library(lmtest)
bptest(model_JDI)
### Multicolonearity
vif(model_JDI)
### Exogeneity
residuals_JDI <- residuals(model_JDI)
cor(residuals_JDI, base_complete[, c("Pay", "Job_Opportunities", "Supervision", "Coworkers", "Work")])
### Normal errors
hist(residuals_JDI, main = "Histogramme des résidus", xlab = "Résidus", col = "lightblue", breaks = 30)
shapiro.test(sample(residuals_JDI, 5000))
##We add the column JDI that will caclculate the JDI for each individual
#We already calculated the "weights" above so we only need to create a new column in base_complete with the values
base_complete$JDI <- model_JDI$coefficients["Pay"]*base_complete$Pay +  model_JDI$coefficients["Job_Opportunities"]*base_complete$Job_Opportunities + model_JDI$coefficients["Supervision"]*base_complete$Supervision + model_JDI$coefficients["Coworkers"]*base_complete$Coworkers + model_JDI$coefficients["Work"]*base_complete$Work
#Logit
model_reg_JDI = clm(Job_Satisfaction ~ Sex + Age + Full_Time + Private + Monotonous + Complex_Tasks + Learning + Career+ Work_Hours  + Salary_log + Mismatch_hours + JDI, data = base_complete)
summary(model_reg_JDI)
mcfadden_r2_JDI <- pR2(model_reg_JDI)
#We display the table showing the coefficients , the R^2 and all necessary information in a table called resultats_regressioin_logit_JDI
stargazer(model_reg_JDI, type = "html", out = "Tableaux/resultats_regression_logit_JDI.html",title = "Estimators for the LOGIT including the JDI",add.lines=list(c("McFadden R²",round(mcfadden_r2_JDI["McFadden"],4))))
install.packages("lmtest")
install.packages("lmtest")
